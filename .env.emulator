# Usado por `npm run dev:emulator` (vite --mode emulator): login e Firestore do emulador local,
# nunca o Firebase real. Valores de demonstração; não precisam do .env.
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-alex-financias.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-alex-financias
VITE_FIREBASE_STORAGE_BUCKET=demo-alex-financias.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
