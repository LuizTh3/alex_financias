rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == 'Jhi9dIY92RbShnVhAVl5CaHuFJK2'
        && request.auth.uid == userId;
    }
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 120
        && name.matches('.*[^\\s].*') && !name.matches('^\\s.*|.*\\s$');
    }
    function validMetadata(data) {
      return data.active is bool && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validCard(data) {
      return data.keys().hasAll(['name', 'color', 'closingDay', 'dueDay', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'color', 'closingDay', 'dueDay', 'active', 'createdAt', 'updatedAt'])
        && validName(data.name) && validMetadata(data)
        && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.closingDay is int && data.closingDay >= 1 && data.closingDay <= 31
        && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31;
    }
    function validCategory(data) {
      return data.keys().hasAll(['name', 'scope', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'scope', 'active', 'createdAt', 'updatedAt'])
        && validName(data.name) && validMetadata(data)
        && data.scope in ['expense', 'income', 'both'];
    }
    function validCreation(data) {
      return data.active == true && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function validUpdate(data) {
      return data.createdAt == resource.data.createdAt && data.updatedAt == request.time;
    }
    match /users/{userId}/cards/{cardId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validCard(request.resource.data) && validCreation(request.resource.data);
      allow update: if isOwner(userId) && validCard(request.resource.data) && validUpdate(request.resource.data);
      // Sem exclusão física: arquivar preserva os vínculos históricos.
    }
    match /users/{userId}/categories/{categoryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validCategory(request.resource.data) && validCreation(request.resource.data);
      allow update: if isOwner(userId) && validCategory(request.resource.data) && validUpdate(request.resource.data);
    }
    function validId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,80}$');
    }
    function validMonth(value) {
      return value is string && value.matches('^(19[0-9]{2}|[2-9][0-9]{3})-(0[1-9]|1[0-2])$');
    }
    function monthDays(month) {
      let y = int(month.split('-')[0]);
      let m = int(month.split('-')[1]);
      return m == 2 ? (y % 400 == 0 || (y % 4 == 0 && y % 100 != 0) ? 29 : 28)
        : (m in [4, 6, 9, 11] ? 30 : 31);
    }
    function civilDate(month, day) {
      let d = day > monthDays(month) ? monthDays(month) : day;
      return month + '-' + (d < 10 ? '0' : '') + string(d);
    }
    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validMonth((value.split('-')[0] + '-' + value.split('-')[1])) && int(value.split('-')[2]) >= 1
        && int(value.split('-')[2]) <= monthDays((value.split('-')[0] + '-' + value.split('-')[1]));
    }
    function shiftedMonth(month, offset) {
      let y = int(month.split('-')[0]);
      let m = int(month.split('-')[1]) - 1 + offset;
      let resultMonth = m % 12 + 1;
      return string(y + int(m / 12)) + '-' + (resultMonth < 10 ? '0' : '') + string(resultMonth);
    }
    function entryShape(data) {
      return data.keys().hasAll(['type', 'description', 'totalCents', 'categoryId', 'purchaseDate', 'paymentMethod', 'cardId', 'installmentCount', 'firstCompetence', 'dueDay', 'revision', 'mutationId', 'deletedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['type', 'description', 'totalCents', 'categoryId', 'purchaseDate', 'paymentMethod', 'cardId', 'installmentCount', 'firstCompetence', 'dueDay', 'revision', 'mutationId', 'deletedAt', 'createdAt', 'updatedAt', 'recurrenceId', 'recurrenceVersionId'])
        && data.type in ['expense', 'income'] && data.description is string
        && data.description.size() >= 1 && data.description.size() <= 240
        && data.description.matches('.*[^\\s].*') && !data.description.matches('^\\s.*|.*\\s$')
        && data.installmentCount is int && data.installmentCount >= 1 && data.installmentCount <= 5
        && data.totalCents is int && data.totalCents >= data.installmentCount && data.totalCents <= 999999999
        && validId(data.categoryId) && validDate(data.purchaseDate)
        && validMonth(data.firstCompetence) && validMonth(shiftedMonth(data.firstCompetence, data.installmentCount - 1))
        && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
        && ((data.paymentMethod == 'direct' && data.cardId == null)
          || (data.paymentMethod == 'card' && data.type == 'expense' && validId(data.cardId)))
        && data.revision is int && data.revision >= 1 && validId(data.mutationId)
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function categoryReference(userId, data) {
      let category = get(/databases/$(database)/documents/users/$(userId)/categories/$(data.categoryId)).data;
      return category.active == true && (category.scope == 'both' || category.scope == data.type);
    }
    function cardReference(userId, data) {
      let card = get(/databases/$(database)/documents/users/$(userId)/cards/$(data.cardId)).data;
      return card.active == true && data.dueDay == card.dueDay;
    }
    function referencesAllowed(userId, data, previous) {
      return ((data.categoryId == previous.categoryId && data.type == previous.type) || categoryReference(userId, data))
        && (data.cardId == null || (data.cardId == previous.cardId ? data.dueDay == previous.dueDay : cardReference(userId, data)));
    }
    function partSlot(userId, entryId, data, index) {
      let path = /databases/$(database)/documents/users/$(userId)/installments/$(entryId + '__' + string(index));
      return data.deletedAt == null && index <= data.installmentCount
        ? (getAfter(path).data.revision == data.revision && getAfter(path).data.updatedAt == request.time)
        : !existsAfter(path);
    }
    function completeSchedule(userId, entryId, data) {
      return partSlot(userId, entryId, data, 1) && partSlot(userId, entryId, data, 2)
        && partSlot(userId, entryId, data, 3) && partSlot(userId, entryId, data, 4)
        && partSlot(userId, entryId, data, 5);
    }
    function invoiceAcknowledges(userId, cardId, competence, entryId, revision) {
      let invoice = cardId == null ? null : getAfter(/databases/$(database)/documents/users/$(userId)/invoices/$(cardId + '__' + competence)).data;
      return cardId == null || (invoice.status == 'pending' && invoice.updatedAt == request.time
        && invoice.lastEntryId == entryId && invoice.lastEntryRevision == revision);
    }
    function editablePart(userId, data) {
      return data.status in [null, 'pending'] && data.settledAt == null
        && invoiceAcknowledges(userId, data.cardId, data.competence, data.entryId, data.revision + 1);
    }
    function partMatchesEntry(userId, partId, data) {
      let entry = getAfter(/databases/$(database)/documents/users/$(userId)/entries/$(data.entryId)).data;
      return entry.deletedAt == null && entry.updatedAt == request.time && data.revision == entry.revision
        && partId == data.entryId + '__' + string(data.index)
        && data.index is int && data.index >= 1 && data.index <= entry.installmentCount
        && data.count == entry.installmentCount
        && data.amountCents is int && data.amountCents == int(entry.totalCents / entry.installmentCount) + (data.index <= entry.totalCents % entry.installmentCount ? 1 : 0)
        && data.competence == shiftedMonth(entry.firstCompetence, data.index - 1)
        && data.cardId == entry.cardId && data.recurrenceId == entry.get('recurrenceId', null) && data.settledAt == null
        && (data.cardId == null ? data.status == 'pending' : data.status == null)
        && (data.cardId == null ? data.dueDate == civilDate(data.competence, entry.dueDay)
          : data.dueDate == getAfter(/databases/$(database)/documents/users/$(userId)/invoices/$(data.cardId + '__' + data.competence)).data.dueDate)
        && invoiceAcknowledges(userId, data.cardId, data.competence, data.entryId, data.revision);
    }
    function partShape(data) {
      return data.keys().hasAll(['entryId', 'revision', 'index', 'count', 'amountCents', 'competence', 'dueDate', 'cardId', 'recurrenceId', 'status', 'settledAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['entryId', 'revision', 'index', 'count', 'amountCents', 'competence', 'dueDate', 'cardId', 'recurrenceId', 'status', 'settledAt', 'createdAt', 'updatedAt', 'settlementRevision', 'lastSettlementEventId'])
        && validId(data.entryId) && data.revision is int && data.count is int
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function partCanBeRemoved(userId, data) {
      let entry = getAfter(/databases/$(database)/documents/users/$(userId)/entries/$(data.entryId)).data;
      return editablePart(userId, data) && entry.updatedAt == request.time && entry.revision == data.revision + 1
        && (entry.deletedAt == request.time || data.index > entry.installmentCount);
    }
    match /users/{userId}/entries/{entryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validId(entryId) && entryShape(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.deletedAt == null && request.resource.data.revision == 1
        && entrySource(userId, entryId, request.resource.data)
        && completeSchedule(userId, entryId, request.resource.data);
      allow update: if isOwner(userId) && resource.data.deletedAt == null && entryShape(request.resource.data)
        && validUpdate(request.resource.data) && sameOccurrence(request.resource.data, resource.data) && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.mutationId != resource.data.mutationId
        && (request.resource.data.deletedAt == null
          ? referencesAllowed(userId, request.resource.data, resource.data)
          : (request.resource.data.deletedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'updatedAt', 'revision', 'mutationId'])))
        && completeSchedule(userId, entryId, request.resource.data);
    }
    match /users/{userId}/installments/{partId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && partShape(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.get('settlementRevision', 0) == 0
        && request.resource.data.get('lastSettlementEventId', null) == null && partMatchesEntry(userId, partId, request.resource.data);
      allow update: if isOwner(userId) && partShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.entryId == resource.data.entryId && request.resource.data.index == resource.data.index
        && ((request.resource.data.revision == resource.data.revision + 1 && sameSettlement(request.resource.data, resource.data)
          && editablePart(userId, resource.data) && partMatchesEntry(userId, partId, request.resource.data))
          || directSettlement(userId, partId, request.resource.data));
      allow delete: if isOwner(userId) && partCanBeRemoved(userId, resource.data);
    }
    function invoiceShape(data) {
      return data.keys().hasAll(['cardId', 'competence', 'dueDate', 'status', 'paidAt', 'paidAmountCents', 'originInstallmentId', 'totalCents', 'chargeCount', 'revision', 'lastMutationId', 'lastEntryId', 'lastEntryRevision', 'lastEventId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['cardId', 'competence', 'dueDate', 'status', 'paidAt', 'paidAmountCents', 'originInstallmentId', 'totalCents', 'chargeCount', 'revision', 'lastMutationId', 'lastEntryId', 'lastEntryRevision', 'lastEventId', 'createdAt', 'updatedAt'])
        && validId(data.cardId) && validMonth(data.competence) && validDate(data.dueDate)
        && data.totalCents is int && data.totalCents >= 0 && data.totalCents <= 999999999999
        && data.chargeCount is int && data.chargeCount >= 0
        && (data.chargeCount == 0 ? data.totalCents == 0 : data.totalCents >= data.chargeCount)
        && data.revision is int && data.revision >= 1 && validId(data.lastMutationId)
        && validId(data.lastEntryId) && data.lastEntryRevision is int && data.lastEntryRevision >= 1
        && (data.lastEventId == null || validId(data.lastEventId))
        && data.createdAt is timestamp && data.updatedAt == request.time
        && (data.status == 'pending' ? data.paidAt == null && data.paidAmountCents == null
          : data.status == 'paid' && data.paidAt is timestamp && data.paidAmountCents == data.totalCents && data.totalCents > 0);
    }
    function previousEntry(userId, entryId) {
      let path = /databases/$(database)/documents/users/$(userId)/entries/$(entryId);
      return exists(path) ? get(path).data : {'cardId': null, 'deletedAt': null, 'firstCompetence': '1900-01', 'installmentCount': 1, 'totalCents': 0, 'revision': 0};
    }
    function contribution(entry, cardId, competence) {
      let offset = (int(competence.split('-')[0]) - int(entry.firstCompetence.split('-')[0])) * 12
        + int(competence.split('-')[1]) - int(entry.firstCompetence.split('-')[1]);
      return entry.cardId == cardId && entry.deletedAt == null && offset >= 0 && offset < entry.installmentCount
        ? {'amount': int(entry.totalCents / entry.installmentCount) + (offset < entry.totalCents % entry.installmentCount ? 1 : 0), 'count': 1}
        : {'amount': 0, 'count': 0};
    }
    function balanceChange(userId, data, oldTotal, oldCount) {
      let before = previousEntry(userId, data.lastEntryId);
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/entries/$(data.lastEntryId)).data;
      let oldPart = contribution(before, data.cardId, data.competence);
      let newPart = contribution(after, data.cardId, data.competence);
      return after.updatedAt == request.time && after.revision == before.revision + 1
        && data.lastEntryRevision == after.revision && data.lastMutationId == after.mutationId
        && (oldPart.count > 0 || newPart.count > 0)
        && data.totalCents == oldTotal - oldPart.amount + newPart.amount
        && data.chargeCount == oldCount - oldPart.count + newPart.count;
    }
    function newInvoice(userId, invoiceKey, data) {
      let part = getAfter(/databases/$(database)/documents/users/$(userId)/installments/$(data.originInstallmentId)).data;
      let entry = getAfter(/databases/$(database)/documents/users/$(userId)/entries/$(data.lastEntryId)).data;
      return invoiceShape(data) && invoiceKey == data.cardId + '__' + data.competence
        && data.createdAt == request.time && data.revision == 1 && data.lastEventId == null
        && data.status == 'pending' && data.dueDate == civilDate(data.competence, entry.dueDay)
        && part.entryId == data.lastEntryId && part.cardId == data.cardId
        && part.competence == data.competence && part.dueDate == data.dueDate && part.updatedAt == request.time
        && balanceChange(userId, data, 0, 0);
    }
    function aggregateUpdate(userId, data) {
      return resource.data.status == 'pending' && data.status == 'pending'
        && data.diff(resource.data).affectedKeys().hasOnly(['totalCents', 'chargeCount', 'revision', 'lastMutationId', 'lastEntryId', 'lastEntryRevision', 'updatedAt'])
        && balanceChange(userId, data, resource.data.totalCents, resource.data.chargeCount);
    }
    function eventShape(data) {
      return data.keys().hasAll(['invoiceId', 'cardId', 'competence', 'dueDate', 'type', 'amountCents', 'invoiceRevision', 'paymentEventId', 'paidAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['invoiceId', 'cardId', 'competence', 'dueDate', 'type', 'amountCents', 'invoiceRevision', 'paymentEventId', 'paidAt', 'createdAt', 'updatedAt'])
        && data.type in ['payment', 'reversal'] && data.amountCents is int && data.amountCents > 0
        && data.amountCents <= 999999999999 && data.invoiceRevision is int
        && validId(data.paymentEventId) && data.paidAt is timestamp
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function eventMatches(userId, invoiceKey, eventId, before, after) {
      let event = getAfter(/databases/$(database)/documents/users/$(userId)/invoiceEvents/$(eventId)).data;
      return eventShape(event) && event.invoiceId == invoiceKey && event.cardId == before.cardId
        && event.competence == before.competence && event.dueDate == before.dueDate
        && event.invoiceRevision == after.revision
        && (before.status == 'pending'
          ? event.type == 'payment' && event.amountCents == before.totalCents && event.paidAt == request.time && event.paymentEventId == eventId
          : event.type == 'reversal' && event.amountCents == before.paidAmountCents && event.paidAt == before.paidAt && event.paymentEventId == before.lastEventId);
    }
    function paymentUpdate(userId, invoiceKey, data) {
      return data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidAmountCents', 'revision', 'lastMutationId', 'lastEventId', 'updatedAt'])
        && data.lastEventId == data.lastMutationId && validId(data.lastEventId)
        && (resource.data.status == 'pending'
          ? (data.status == 'paid' && resource.data.chargeCount > 0 && data.paidAt == request.time && data.paidAmountCents == resource.data.totalCents)
          : (resource.data.status == 'paid' && data.status == 'pending' && data.paidAt == null && data.paidAmountCents == null))
        && eventMatches(userId, invoiceKey, data.lastEventId, resource.data, data);
    }
    match /users/{userId}/invoices/{invoiceKey} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && newInvoice(userId, invoiceKey, request.resource.data);
      allow update: if isOwner(userId) && invoiceShape(request.resource.data) && validUpdate(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.lastMutationId != resource.data.lastMutationId
        && (aggregateUpdate(userId, request.resource.data) || paymentUpdate(userId, invoiceKey, request.resource.data));
    }
    match /users/{userId}/invoiceEvents/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validId(eventId) && eventShape(request.resource.data)
        && validEventTransition(userId, eventId, request.resource.data);
    }
    function validEventTransition(userId, eventId, event) {
      let before = get(/databases/$(database)/documents/users/$(userId)/invoices/$(event.invoiceId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/invoices/$(event.invoiceId)).data;
      return event.invoiceId == before.cardId + '__' + before.competence
        && after.lastEventId == eventId && after.lastMutationId == eventId && after.updatedAt == request.time
        && after.revision == before.revision + 1
        && (event.type == 'payment' ? before.status == 'pending' && after.status == 'paid' : before.status == 'paid' && after.status == 'pending')
        && eventMatches(userId, event.invoiceId, eventId, before, after);
    }
    function localMonth() {
      let time = request.time - duration.value(5, 'h');
      return string(time.year()) + '-' + (time.month() < 10 ? '0' : '') + string(time.month());
    }
    function recurrenceIdValid(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,40}$');
    }
    function recurrenceRootShape(data, id) {
      return data.keys().hasAll(['startCompetence', 'latestFrom', 'latestVersionId', 'revision', 'state', 'mutationId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['startCompetence', 'latestFrom', 'latestVersionId', 'revision', 'state', 'mutationId', 'createdAt', 'updatedAt'])
        && recurrenceIdValid(id) && validMonth(data.startCompetence) && validMonth(data.latestFrom)
        && data.latestFrom >= data.startCompetence && data.revision is int && data.revision >= 1
        && data.latestVersionId == id + '__' + string(data.revision)
        && data.state in ['active', 'paused', 'ended'] && validId(data.mutationId)
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function versionShape(data) {
      return data.keys().hasAll(['recurrenceId', 'revision', 'effectiveFrom', 'validUntil', 'description', 'amountCents', 'categoryId', 'paymentMethod', 'cardId', 'dueDay', 'action', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['recurrenceId', 'revision', 'effectiveFrom', 'validUntil', 'description', 'amountCents', 'categoryId', 'paymentMethod', 'cardId', 'dueDay', 'action', 'active', 'createdAt', 'updatedAt'])
        && recurrenceIdValid(data.recurrenceId) && data.revision is int && data.revision >= 1
        && validMonth(data.effectiveFrom) && (data.validUntil == null || validMonth(data.validUntil) && data.validUntil >= data.effectiveFrom)
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 240
        && data.description.matches('.*[^\\s].*') && !data.description.matches('^\\s.*|.*\\s$')
        && data.amountCents is int && data.amountCents >= 1 && data.amountCents <= 999999999
        && validId(data.categoryId) && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31
        && (data.paymentMethod == 'direct' && data.cardId == null || data.paymentMethod == 'card' && validId(data.cardId))
        && data.action in ['configure', 'pause', 'end'] && data.active == (data.action == 'configure')
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function rootVersionMatches(userId, id, data) {
      let version = getAfter(/databases/$(database)/documents/users/$(userId)/recurrenceVersions/$(data.latestVersionId)).data;
      return version.recurrenceId == id && version.revision == data.revision && version.effectiveFrom == data.latestFrom
        && version.validUntil == null && version.createdAt == request.time
        && data.state == (version.action == 'configure' ? 'active' : version.action == 'pause' ? 'paused' : 'ended');
    }
    function closesPrevious(userId, before, after) {
      let version = getAfter(/databases/$(database)/documents/users/$(userId)/recurrenceVersions/$(before.latestVersionId)).data;
      return version.validUntil == after.latestFrom && version.updatedAt == request.time;
    }
    match /users/{userId}/recurrences/{id} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && recurrenceRootShape(request.resource.data, id)
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1
        && request.resource.data.startCompetence == request.resource.data.latestFrom && request.resource.data.state == 'active'
        && rootVersionMatches(userId, id, request.resource.data);
      allow update: if isOwner(userId) && recurrenceRootShape(request.resource.data, id) && resource.data.state != 'ended'
        && validUpdate(request.resource.data) && request.resource.data.startCompetence == resource.data.startCompetence
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.mutationId != resource.data.mutationId
        && request.resource.data.latestFrom >= resource.data.latestFrom && request.resource.data.latestFrom >= localMonth()
        && rootVersionMatches(userId, id, request.resource.data) && closesPrevious(userId, resource.data, request.resource.data);
    }
    function versionReferences(userId, data) {
      let root = getAfter(/databases/$(database)/documents/users/$(userId)/recurrences/$(data.recurrenceId)).data;
      let previousId = data.recurrenceId + '__' + string(data.revision - 1);
      let previous = data.revision == 1 ? {'categoryId': '', 'cardId': null, 'dueDay': 0}
        : get(/databases/$(database)/documents/users/$(userId)/recurrenceVersions/$(previousId)).data;
      return root.latestVersionId == data.recurrenceId + '__' + string(data.revision) && root.updatedAt == request.time
        && root.latestFrom == data.effectiveFrom && root.revision == data.revision
        && (data.categoryId == previous.categoryId || categoryReference(userId, {'categoryId': data.categoryId, 'type': 'expense'}))
        && (data.cardId == null || (data.cardId == previous.cardId ? (data.action == 'configure' ? data.dueDay == get(/databases/$(database)/documents/users/$(userId)/cards/$(data.cardId)).data.dueDay : data.dueDay == previous.dueDay) : cardReference(userId, data)))
        && (data.action == 'configure' || data.revision > 1 && data.description == previous.description && data.amountCents == previous.amountCents
          && data.categoryId == previous.categoryId && data.paymentMethod == previous.paymentMethod && data.cardId == previous.cardId && data.dueDay == previous.dueDay);
    }
    function closesVersion(userId, data) {
      let before = get(/databases/$(database)/documents/users/$(userId)/recurrences/$(data.recurrenceId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/recurrences/$(data.recurrenceId)).data;
      return resource.data.validUntil == null && data.validUntil == after.latestFrom
        && before.latestVersionId == data.recurrenceId + '__' + string(data.revision)
        && after.revision == before.revision + 1 && after.updatedAt == request.time;
    }
    match /users/{userId}/recurrenceVersions/{versionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && versionShape(request.resource.data)
        && versionId == request.resource.data.recurrenceId + '__' + string(request.resource.data.revision)
        && request.resource.data.createdAt == request.time && request.resource.data.validUntil == null
        && versionReferences(userId, request.resource.data);
      allow update: if isOwner(userId) && versionShape(request.resource.data)
        && validUpdate(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validUntil', 'updatedAt'])
        && closesVersion(userId, request.resource.data);
    }
    function occurrenceSource(userId, entryId, data) {
      let version = get(/databases/$(database)/documents/users/$(userId)/recurrenceVersions/$(data.recurrenceVersionId)).data;
      return version.active == true && version.recurrenceId == data.recurrenceId
        && entryId == 'occ_' + data.recurrenceId + '_' + data.firstCompetence
        && data.firstCompetence >= version.effectiveFrom && (version.validUntil == null || data.firstCompetence < version.validUntil)
        && data.type == 'expense' && data.installmentCount == 1 && data.purchaseDate == civilDate(data.firstCompetence, 1)
        && data.description == version.description && data.totalCents == version.amountCents && data.categoryId == version.categoryId
        && data.paymentMethod == version.paymentMethod && data.cardId == version.cardId
        && (data.cardId == null ? data.dueDay == version.dueDay : data.dueDay == get(/databases/$(database)/documents/users/$(userId)/cards/$(data.cardId)).data.dueDay);
    }
    function entrySource(userId, entryId, data) {
      return data.get('recurrenceId', null) == null
        ? data.get('recurrenceVersionId', null) == null && referencesAllowed(userId, data, {'categoryId': '', 'type': '', 'cardId': null, 'dueDay': 0})
        : recurrenceIdValid(data.recurrenceId) && validId(data.recurrenceVersionId) && occurrenceSource(userId, entryId, data);
    }
    function sameOccurrence(data, before) {
      return data.get('recurrenceId', null) == before.get('recurrenceId', null)
        && data.get('recurrenceVersionId', null) == before.get('recurrenceVersionId', null)
        && (before.get('recurrenceId', null) == null || data.type == 'expense' && data.installmentCount == 1
          && data.firstCompetence == before.firstCompetence && data.purchaseDate == before.purchaseDate);
    }
    function settlementEventShape(data) {
      return data.keys().hasAll(['installmentId', 'entryId', 'entryRevision', 'type', 'amountCents', 'dueDate', 'settlementRevision', 'confirmationEventId', 'confirmedAt', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['installmentId', 'entryId', 'entryRevision', 'type', 'amountCents', 'dueDate', 'settlementRevision', 'confirmationEventId', 'confirmedAt', 'description', 'createdAt', 'updatedAt'])
        && data.type in ['payment', 'receipt', 'reversal'] && data.amountCents is int && data.amountCents > 0
        && data.settlementRevision is int && data.entryRevision is int && validId(data.entryId) && validId(data.confirmationEventId)
        && data.confirmedAt is timestamp && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function settlementEventMatches(userId, partId, eventId, before, after, entry) {
      let event = getAfter(/databases/$(database)/documents/users/$(userId)/settlementEvents/$(eventId)).data;
      return settlementEventShape(event) && event.installmentId == partId && event.entryId == before.entryId
        && event.entryRevision == before.revision && event.amountCents == before.amountCents && event.dueDate == before.dueDate
        && event.description == entry.description && event.settlementRevision == after.settlementRevision
        && (before.status == 'pending' ? event.type == (entry.type == 'income' ? 'receipt' : 'payment')
          && event.confirmedAt == request.time && event.confirmationEventId == eventId
          : event.type == 'reversal' && event.confirmedAt == before.settledAt && event.confirmationEventId == before.lastSettlementEventId);
    }
    function directSettlement(userId, partId, data) {
      let entry = get(/databases/$(database)/documents/users/$(userId)/entries/$(resource.data.entryId)).data;
      let afterEntry = getAfter(/databases/$(database)/documents/users/$(userId)/entries/$(resource.data.entryId)).data;
      return resource.data.cardId == null && entry.paymentMethod == 'direct' && entry.deletedAt == null
        && entry.revision == resource.data.revision && afterEntry == entry
        && data.diff(resource.data).affectedKeys().hasOnly(['status', 'settledAt', 'settlementRevision', 'lastSettlementEventId', 'updatedAt'])
        && data.settlementRevision is int && data.settlementRevision == resource.data.get('settlementRevision', 0) + 1
        && validId(data.lastSettlementEventId) && data.lastSettlementEventId != resource.data.get('lastSettlementEventId', null)
        && (resource.data.status == 'pending' ? data.status == (entry.type == 'income' ? 'received' : 'paid') && data.settledAt == request.time
          : resource.data.status == (entry.type == 'income' ? 'received' : 'paid') && data.status == 'pending' && data.settledAt == null)
        && settlementEventMatches(userId, partId, data.lastSettlementEventId, resource.data, data, entry);
    }
    function sameSettlement(data, before) {
      return data.get('settlementRevision', 0) == before.get('settlementRevision', 0)
        && data.get('lastSettlementEventId', null) == before.get('lastSettlementEventId', null);
    }
    match /users/{userId}/settlementEvents/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validId(eventId) && settlementEventShape(request.resource.data)
        && settlementEventTransition(userId, eventId, request.resource.data);
    }
    function settlementEventTransition(userId, eventId, event) {
      let before = get(/databases/$(database)/documents/users/$(userId)/installments/$(event.installmentId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/installments/$(event.installmentId)).data;
      let entry = get(/databases/$(database)/documents/users/$(userId)/entries/$(before.entryId)).data;
      return before.cardId == null && after.lastSettlementEventId == eventId && after.updatedAt == request.time
        && after.settlementRevision == before.get('settlementRevision', 0) + 1
        && (event.type == 'reversal' ? after.status == 'pending' && before.status != 'pending' : before.status == 'pending' && after.status != 'pending')
        && settlementEventMatches(userId, event.installmentId, eventId, before, after, entry);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
